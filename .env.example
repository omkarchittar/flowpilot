POSTGRES_PASSWORD=local-development-only
FLOWPILOT_DATABASE_URL=postgresql+psycopg://flowpilot:local-development-only@localhost:5434/flowpilot
FLOWPILOT_OPENAI_API_KEY=
FLOWPILOT_GENERATION_MODEL=gpt-4.1-mini
FLOWPILOT_ENCRYPTION_KEY=
# Production requires HTTPS and an exact public origin.
FLOWPILOT_ENVIRONMENT=development
FLOWPILOT_ALLOWED_ORIGINS=["http://localhost:3001"]
FLOWPILOT_UPLOAD_LIMIT_BYTES=10000000
